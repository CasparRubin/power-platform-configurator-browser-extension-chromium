{
  "name": "power-platform-configurator",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/power-platform-configurator-browser-extension-chromium.git"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-helvety.mjs",
    "prebuild": "node scripts/prebuild-copy-public.mjs",
    "build:sw": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=esm --platform=browser --target=es2022",
    "build:content": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --platform=browser --target=es2022",
    "build:content-powerapps": "esbuild src/content-powerapps.ts --bundle --outfile=dist/content-powerapps.js --format=iife --platform=browser --target=es2022",
    "build:popup": "vite build --config vite.popup.config.ts",
    "build": "npm run prebuild && npm run build:sw && npm run build:content && npm run build:content-powerapps && npm run build:popup",
    "watch": "vite build --config vite.popup.config.ts --watch",
    "test": "vitest run --exclude tests/dist-bundle.test.ts",
    "test:dist": "vitest run tests/dist-bundle.test.ts tests/dnr-static-rules.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/dist-bundle.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:naming": "node scripts/verify-project-naming.mjs",
    "package:zip": "node scripts/package-dist-zip.mjs",
    "predeploy": "npm run verify:naming && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:dist && npm run package:zip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@helvety/extension-chrome": "file:.helvety/packages/extension-chrome",
    "@helvety/shared": "file:.helvety/packages/shared",
    "@helvety/ui": "file:.helvety/packages/ui",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "$react",
    "react-dom": "$react-dom",
    "@helvety/shared": "file:.helvety/packages/shared",
    "@helvety/ui": "file:.helvety/packages/ui",
    "@helvety/extension-chrome": "file:.helvety/packages/extension-chrome",
    "@helvety/config": "file:.helvety/packages/config"
  }
}
