{
  "manifest_version": 3,
  "name": "Power Platform Configurator",
  "version": "2.8.3",
  "description": "Configure Microsoft Power Automate Cloud Flows: choose Classic or New Designer (v3=false or v3=true), and optionally hide the Microsoft survey prompt asking why you made your selection.",
  "homepage_url": "https://helvety.com",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage"],
  "host_permissions": ["https://*.powerautomate.com/*", "https://flow.microsoft.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Power Platform Configurator"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dnr-classic-editor",
        "enabled": true,
        "path": "dnr-classic-editor.json"
      },
      {
        "id": "dnr-new-designer",
        "enabled": false,
        "path": "dnr-new-designer.json"
      }
    ]
  },
  "icons": {
    "16": "icons/ppconfigurator_16.png",
    "32": "icons/ppconfigurator_32.png",
    "48": "icons/ppconfigurator_48.png",
    "128": "icons/ppconfigurator_128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.powerautomate.com/*", "https://flow.microsoft.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
